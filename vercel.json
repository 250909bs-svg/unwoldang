{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.portone.io; connect-src 'self' https://*.run.app https://api.portone.io https://*.portone.io https://kauth.kakao.com https://kapi.kakao.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; media-src 'self' data: blob:; frame-src https://*.portone.io https://*.inicis.com https://*.kginicis.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self' https://*.portone.io https://*.inicis.com https://*.kginicis.com"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/media/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/my/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/search",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/form/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/checkout",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/loading",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/report/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/payment/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/seo/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/detail/past-life-goblin/:path(immersion|about)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/menu",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tarot",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "unwoldang.com" }],
      "destination": "https://www.unwoldang.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "unwoldang.com" }],
      "destination": "https://www.unwoldang.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/detail/general-saju",
      "destination": "/seo/detail-general-saju.html"
    },
    {
      "source": "/detail/past-life-goblin",
      "destination": "/seo/detail-past-life-goblin.html"
    },
    {
      "source": "/detail/love-reading",
      "destination": "/seo/detail-love-reading.html"
    },
    {
      "source": "/detail/past-life-goblin/immersion",
      "destination": "/index.html"
    },
    {
      "source": "/detail/past-life-goblin/about",
      "destination": "/index.html"
    },
    {
      "source": "/detail/:path*",
      "destination": "/api/retired-detail"
    },
    {
      "source": "/test",
      "destination": "/seo/test.html"
    },
    {
      "source": "/test/face-ai",
      "destination": "/seo/test-face-ai.html"
    },
    {
      "source": "/terms",
      "destination": "/seo/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/refund",
      "destination": "/seo/refund.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/my",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/auth/kakao/callback",
      "destination": "/index.html"
    },
    {
      "source": "/payment/portone/callback",
      "destination": "/index.html"
    },
    {
      "source": "/form/:id(general-signature|life-flow|concern-reading|past-life-goblin|love-reading|love-reunion|match-couple|match-destiny|marriage-blueprint|marriage-timing|career-reading|money-reading)",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/loading",
      "destination": "/index.html"
    },
    {
      "source": "/report/:id(general-signature|life-flow|concern-reading|past-life-goblin|love-reading|love-reunion|match-couple|match-destiny|marriage-blueprint|marriage-timing|career-reading|money-reading)",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/not-found"
    }
  ]
}
