PORT=8080
PAYMENT_PROVIDER=disabled
ALLOWED_ORIGINS=https://unwoldang.com,https://www.unwoldang.com,https://unwoldang.vercel.app,http://localhost:5173,http://127.0.0.1:5173

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_REQUEST_TIMEOUT_MS=22000
KASI_LUNAR_SERVICE_KEY=your_kasi_lunar_decoding_key
KASI_SPECIALDAY_SERVICE_KEY=your_kasi_specialday_decoding_key
# Legacy fallback only. Prefer the two dedicated keys above.
KASI_SERVICE_KEY=
KASI_REQUEST_TIMEOUT_MS=5000

KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret_if_enabled

PORTONE_API_SECRET=your_portone_v2_api_secret
PORTONE_STORE_ID=store-your-portone-store-id
PORTONE_API_BASE_URL=https://api.portone.io
PORTONE_PAYMENT_LEDGER_COLLECTION=portonePaymentConfirmations

REPORT_ACCESS_SECRET=replace_with_a_long_random_secret_value
USER_ACCESS_SECRET=replace_with_a_different_long_random_secret_value
ADMIN_ACCESS_SECRET=replace_with_a_third_long_random_secret_value
REPORT_ACCESS_TOKEN_TTL_MS=1800000
PAYMENT_ORDER_CLAIM_TTL_MS=7200000
REPORT_GENERATION_LOCK_TTL_MS=120000
AUTH_ACCESS_TOKEN_TTL_MS=2592000000
ADMIN_ACCESS_TOKEN_TTL_MS=43200000
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX=5
REPORT_RATE_LIMIT_WINDOW_MS=60000
REPORT_RATE_LIMIT_MAX=12

ENABLE_FIRESTORE_ARCHIVE=true
FIRESTORE_PROJECT_ID=your-gcp-project-id
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_ARCHIVE_COLLECTION=reportArchives
REQUIRE_REPORT_TOKEN_FOR_ARCHIVE=true

# Store this SHA-256(adminId:password) value in Secret Manager for production.
ADMIN_CREDENTIAL_HASH=sha256_of_adminId_colon_password

# Local development only. Never enable unverified reports in Cloud Run.
ALLOW_UNVERIFIED_REPORTS=false
# Optional local emulator/manual REST credential. Cloud Run should use its service account.
FIRESTORE_ACCESS_TOKEN=
