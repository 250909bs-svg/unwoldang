VITE_KAKAO_REST_API_KEY=your_kakao_rest_api_key
VITE_KAKAO_TOKEN_EXCHANGE_ENDPOINT=https://unwoldang-report-api-pt76url4oa-du.a.run.app/api/auth/kakao/exchange
VITE_KAKAO_REDIRECT_ORIGIN=https://www.unwoldang.com
VITE_KAKAO_SCOPES=
VITE_PUBLIC_SITE_URL=https://www.unwoldang.com

# demo | test | live
VITE_PAYMENT_MODE=live
VITE_PORTONE_STORE_ID=store-your-portone-store-id
VITE_PORTONE_CHANNEL_KEY=channel-key-for-kg-inicis
# The frontend derives /order, /entitlements, and /entitlement/renew from this URL.
VITE_PORTONE_CONFIRM_ENDPOINT=https://your-cloud-run-url/api/payments/portone/confirm
VITE_PORTONE_DEFAULT_PHONE_NUMBER=01000000000
VITE_PORTONE_DEFAULT_EMAIL=customer@unwoldang.com

VITE_REPORT_ENDPOINT=https://unwoldang-report-api-pt76url4oa-du.a.run.app/api/report
VITE_REPORT_ARCHIVE_ENDPOINT=https://unwoldang-report-api-pt76url4oa-du.a.run.app/api/archive/reports
VITE_ADMIN_LOGIN_ENDPOINT=https://unwoldang-report-api-pt76url4oa-du.a.run.app/api/admin/login
VITE_ADMIN_REPORTS_ENDPOINT=https://unwoldang-report-api-pt76url4oa-du.a.run.app/api/admin/reports
VITE_REPORT_TIMEOUT_MS=70000

# Client admin hash is for local fallback only. Production admin should use the Cloud Run admin API.
VITE_ENABLE_CLIENT_ADMIN=false
VITE_LOCAL_ADMIN_CREDENTIAL_HASH=

# Server-only values intentionally live in cloudrun-api/.env.example.
# Never copy PORTONE/API/signing/admin secrets into Vercel frontend variables.
